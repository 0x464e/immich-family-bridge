# Compose variables for docker-compose.example.yaml. Copy this file to .env or
# pass a private copy with docker compose --env-file. These values are read by
# Compose on the Docker host; they are not Immich API keys.

# Absolute host path to the bridge YAML configuration. Copy config.example.yaml,
# edit its family, member, and path settings, then put that private file here.
BRIDGE_CONFIG=/absolute/path/to/bridge-config.yaml

# Absolute host path to a private runtime environment file. Start from
# secrets.env.example; it holds the API keys and internal bearer token that
# Compose passes into the bridge container through env_file.
BRIDGE_ENV_FILE=/absolute/path/to/bridge.private.env

# Absolute host path to ONE media tree containing readable source originals
# and the bridge recipient directory. Compose mounts it at /media inside the
# bridge container. Hardlinks may fail across separate container bind mounts.
BRIDGE_MEDIA_ROOT=/absolute/path/to/shared-media-tree

# Mount mode for that media tree: ro for a dry run, rw for active linking.
# Change to rw only when FAMILYBRIDGE_DRY_RUN=false and host
# permissions limit bridge writes to the recipient directory.
BRIDGE_MEDIA_MODE=ro

# Keep the bridge running in read-only preview mode. Set false only after
# reviewing its logs, testing the mount, and setting BRIDGE_MEDIA_MODE=rw.
FAMILYBRIDGE_DRY_RUN=true

# Absolute host path to persistent local state storage, mounted at /state.
# The bridge UID:GID needs write access here for its SQLite database.
BRIDGE_STATE_ROOT=/absolute/path/to/local-bridge-state

# Exact name of the existing Docker network used by Immich, shown by
# docker network ls. The bridge must reach immich_url on this network.
IMMICH_NETWORK=immich_default

# Host loopback port for the bridge API. Compose maps 127.0.0.1:8081 to the
# container's port 8080 by default; choose another free host port if needed.
BRIDGE_PORT=8081

# Numeric host user ID for the bridge process. It must be able to read source
# files and write the state directory and recipient tree. Defaults to 1000.
PUID=1000

# Numeric host group ID for that process. Match the filesystem's group access
# or ACLs alongside PUID. Defaults to 1000 if omitted.
PGID=1000
